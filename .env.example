# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="your_project_id"
VITE_APPWRITE_DATABASE_ID="your_database_id"
VITE_APPWRITE_ANNOTATIONS_COLLECTION_ID="your_annotations_collection_id"
VITE_APPWRITE_CONVERSATIONS_COLLECTION_ID="your_conversations_id"
VITE_APPWRITE_MESSAGES_COLLECTION_ID="your_messages_id"
VITE_APPWRITE_PARTICIPANTS_COLLECTION_ID="your_participants_id"
VITE_APPWRITE_MESSAGE_STATUS_COLLECTION_ID="your_status_id"
VITE_APPWRITE_ATTACHMENTS_COLLECTION_ID="your_attachments_id"
VITE_APPWRITE_CALLS_COLLECTION_ID="your_calls_id"
VITE_APPWRITE_SIGNALS_COLLECTION_ID="your_signals_id"
VITE_APPWRITE_STORAGE_BUCKET_ID="your_bucket_id"

# Supabase Configuration
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Never add a service-role key here; VITE_* variables are bundled into the app.

