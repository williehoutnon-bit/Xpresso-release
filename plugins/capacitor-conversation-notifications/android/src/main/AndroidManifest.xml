<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            Only ONE FirebaseMessagingService receives each FCM message: the one with the
            highest intent-filter priority. Capacitor's push-notifications service uses the
            default priority (0), so this one (100) wins. For anything that is not a chat
            message, ChatMessagingService forwards the message to Capacitor's plugin itself.
        -->
        <service
            android:name="com.xpresso.convnotif.ChatMessagingService"
            android:exported="false">
            <intent-filter android:priority="100">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
